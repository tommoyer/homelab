#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="{{ glance_config_repo_path }}"
LIVE_DIR="{{ glance_live_config_path }}"
BRANCH="{{ glance_config_repo_version }}"

cd "$REPO_DIR"
git fetch origin
git checkout "$BRANCH"
git reset --hard "origin/$BRANCH"

{% if glance_webhook_validate_config %}
docker run --rm \
  -v "${REPO_DIR}/glance.yml:/app/config/glance.yml" \
  glanceapp/glance:latest \
  config:print >/dev/null
{% endif %}

rsync -av --delete \
  --no-owner --no-group --no-perms --omit-dir-times \
  "$REPO_DIR/glance.yml" \
  "$REPO_DIR/pages/" \
  "$REPO_DIR/assets/" \
  "$LIVE_DIR/"